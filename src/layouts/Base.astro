---
import { getEntry } from 'astro:content';
import '../styles/global.css';
import sans from '../assets/fonts/geist-latin-wght-normal.woff2?url';
import mono from '../assets/fonts/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const home = (await getEntry('site', 'home'))!.data;
const { title, description = home.positioning } = Astro.props;
const pageTitle = title ? `${title} — ${home.name}` : home.name;
const conversationHref = home.cta.conversationHref ?? '#contact';

const fontFaces = `
@font-face{font-family:"Geist";font-style:normal;font-weight:100 900;font-display:swap;src:url(${sans}) format("woff2-variations")}
@font-face{font-family:"Geist Mono";font-style:normal;font-weight:100 900;font-display:swap;src:url(${mono}) format("woff2-variations")}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- M0 design mock: keep out of search until launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0A0A0B" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces} is:inline />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead wrap">
      <a class="monogram" href="/" aria-label={`${home.name}, home`}>
        <span aria-hidden="true">KK</span>
      </a>
      <nav class="masthead__nav" aria-label="Sections">
        <a href="/#work">Work</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon wrap" id="contact">
      <div class="colophon__row">
        <p class="label">Contact</p>
        <ul class="colophon__links">
          {
            home.cta.conversationHref && (
              <li>
                <a class="link" href={conversationHref}>
                  {home.cta.conversation} <span aria-hidden="true">↗</span>
                </a>
              </li>
            )
          }
          {
            home.links.map((l) => (
              <li>
                <a class="link" href={l.href} rel="noopener">
                  {l.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </body>
</html>
