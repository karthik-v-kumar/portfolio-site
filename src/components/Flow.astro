---
// A plain flow diagram built from text boxes. Stacks top to bottom on narrow
// screens and runs left to right on wide ones. Steps with an AI agent are
// highlighted, and an optional dashed arrow marks a loop back to an earlier step.
interface Step {
  label: string;
  items: string[];
  agent?: { name: string; text: string };
}
interface Props {
  number: string;
  flow: {
    alt: string;
    caption: string;
    steps: Step[];
    loop?: { from: number; to: number; short: string; label: string };
  };
}
const { number, flow } = Astro.props;
const { loop } = flow;
const hasAgents = flow.steps.some((s) => s.agent);
---

<figure class="plate">
  <div class="plate__frame">
    <div class="flow" role="img" aria-label={flow.alt}>
      <div class="flow__grid">
        <ol class="flow__steps">
          {
            flow.steps.map((s, i) => (
              <li class:list={['flow__step', s.agent && 'flow__step--agent']}>
                <span class="flow__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="flow__label">{s.label}</span>
                {s.items.length > 0 && (
                  <ul class="flow__items">
                    {s.items.map((it) => <li>{it}</li>)}
                  </ul>
                )}
                {s.agent && (
                  <div class="flow__agent">
                    <span class="flow__agent-tag">AI agent</span>
                    <span class="flow__agent-name">{s.agent.name}</span>
                    <span class="flow__agent-text">{s.agent.text}</span>
                  </div>
                )}
              </li>
            ))
          }
        </ol>
        {
          loop && (
            <div
              class="flow__loop"
              style={`--from:${loop.from};--to:${loop.to};--span:${loop.from - loop.to + 1}`}
            >
              <span class="flow__loop-tag">{loop.short}</span>
            </div>
          )
        }
      </div>
      {
        (hasAgents || loop) && (
          <ul class="flow__key">
            {hasAgents && (
              <li>
                <span class="flow__swatch flow__swatch--agent" />
                <span>Step where an AI agent works</span>
              </li>
            )}
            {loop && (
              <li>
                <span class="flow__swatch flow__swatch--loop" />
                <span>{loop.label}</span>
              </li>
            )}
          </ul>
        )
      }
    </div>
  </div>
  <figcaption class="plate__caption">
    <span class="idx">Fig. {number}</span>
    <span>{flow.caption}</span>
  </figcaption>
</figure>
