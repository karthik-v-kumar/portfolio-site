---
// Small line illustrations for feature cards. Shapes only: no figures, no data.
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

<svg class="art" viewBox="0 0 240 120" aria-hidden="true" focusable="false">
  {kind === 'score' && (
    <g>
      <circle class="art-rule" cx="52" cy="60" r="30" />
      <path class="art-accent" d="M52 30 A30 30 0 0 1 80.5 69.3" />
      {[0, 1, 2, 3, 4].map((i) => (
        <g>
          <line class="art-rule" x1="112" x2="216" y1={32 + i * 14} y2={32 + i * 14} />
          <line class="art-ink" x1="112" x2={112 + [104, 58, 0, 80, 34][i]} y1={32 + i * 14} y2={32 + i * 14} />
        </g>
      ))}
    </g>
  )}
  {kind === 'chart' && (
    <g>
      <line class="art-rule" x1="20" x2="220" y1="98" y2="98" />
      <path class="art-ink" d="M20 70 C60 58 90 66 120 60 S180 52 220 62" />
      <path class="art-accent" d="M20 78 L38 62 52 70 70 44 86 56 104 34 120 48 138 40 156 58 172 50 190 72 206 66 220 84" />
    </g>
  )}
  {kind === 'sentiment' && (
    <g>
      <path class="art-rule" d="M40 92 A80 80 0 0 1 200 92" />
      <path class="art-accent" d="M40 92 A80 80 0 0 1 70 30.7" />
      <line class="art-ink" x1="120" y1="92" x2="78" y2="42" />
      <circle class="art-fill" cx="120" cy="92" r="4" />
    </g>
  )}
  {kind === 'calendar' && (
    <g>
      {[0, 1, 2, 3].flatMap((r) => [0, 1, 2, 3, 4, 5, 6].map((c) => (
        <rect class:list={[(r === 1 && c === 3) ? 'art-accent-fill' : (r === 2 && c === 1) || (r === 0 && c === 5) || (r === 3 && c === 4) ? 'art-fill' : 'art-rule']} x={36 + c * 25} y={14 + r * 24} width="18" height="18" />
      )))}
    </g>
  )}
  {kind === 'economy' && (
    <g>
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <g>
          <circle class:list={[i === 0 || i === 3 ? 'art-accent-fill' : 'art-fill']} cx={36 + i * 34} cy="40" r="5" />
          <line class="art-rule" x1={24 + i * 34} x2={48 + i * 34} y1="62" y2="62" />
          <line class="art-rule" x1={24 + i * 34} x2={42 + i * 34} y1="74" y2="74" />
        </g>
      ))}
    </g>
  )}
  {kind === 'chain' && (
    <g>
      {[0, 1, 2, 3, 4].map((i) => (
        <g>
          <line class="art-rule" x1="24" x2="96" y1={24 + i * 18} y2={24 + i * 18} />
          <line class="art-rule" x1="144" x2="216" y1={24 + i * 18} y2={24 + i * 18} />
          <rect class:list={[i === 2 ? 'art-accent-fill' : 'art-fill']} x="108" y={19 + i * 18} width="24" height="10" />
        </g>
      ))}
    </g>
  )}
  {kind === 'builder' && (
    <g>
      <line class="art-rule" x1="20" x2="220" y1="64" y2="64" stroke-dasharray="3 4" />
      <path class="art-accent" d="M20 88 L96 88 L152 30 L220 30" />
      <circle class="art-fill" cx="124" cy="59" r="4" />
    </g>
  )}
  {kind === 'trades' && (
    <g>
      <rect class="art-rule" x="24" y="20" width="192" height="80" />
      <line class="art-ink" x1="40" x2="110" y1="42" y2="42" />
      <line class="art-rule" x1="40" x2="200" y1="76" y2="76" />
      <line class="art-accent" x1="104" x2="150" y1="76" y2="76" />
      <circle class="art-fill" cx="150" cy="76" r="4" />
    </g>
  )}
  {kind === 'glossary' && (
    <g>
      <line class="art-rule" x1="24" x2="84" y1="78" y2="78" />
      <line class="art-ink" x1="92" x2="148" y1="78" y2="78" />
      <line class="art-accent" x1="92" x2="148" y1="86" y2="86" stroke-dasharray="2 4" />
      <line class="art-rule" x1="156" x2="216" y1="78" y2="78" />
      <path class="art-ink" d="M60 20 H180 V58 H128 L120 66 L112 58 H60 Z" />
      <line class="art-rule" x1="74" x2="166" y1="34" y2="34" />
      <line class="art-rule" x1="74" x2="140" y1="46" y2="46" />
    </g>
  )}
  {kind === 'agent' && (
    <g>
      <rect class="art-ink" x="24" y="38" width="64" height="44" />
      <rect class="art-rule" x="152" y="38" width="64" height="44" />
      <line class="art-accent" x1="88" x2="152" y1="52" y2="52" />
      <line class="art-accent" x1="152" x2="88" y1="68" y2="68" stroke-dasharray="3 4" />
      <circle class="art-fill" cx="56" cy="60" r="5" />
      <line class="art-rule" x1="164" x2="204" y1="52" y2="52" />
      <line class="art-rule" x1="164" x2="204" y1="60" y2="60" />
      <line class="art-rule" x1="164" x2="190" y1="68" y2="68" />
    </g>
  )}
  {kind === 'list' && (
    <g>
      {[0, 1, 2, 3].map((i) => (
        <g>
          <rect class:list={[i === 1 ? 'art-accent-fill' : 'art-rule']} x="40" y={22 + i * 21} width="12" height="12" />
          <line class:list={[i === 1 ? 'art-rule' : 'art-ink']} x1="66" x2={[190, 160, 200, 140][i]} y1={28 + i * 21} y2={28 + i * 21} />
        </g>
      ))}
    </g>
  )}
  {kind === 'bars' && (
    <g>
      <line class="art-rule" x1="30" x2="210" y1="98" y2="98" />
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <rect class:list={[i === 3 ? 'art-accent-fill' : 'art-fill']} x={42 + i * 28} y={98 - [38, 54, 30, 70, 46, 60][i]} width="14" height={[38, 54, 30, 70, 46, 60][i]} />
      ))}
    </g>
  )}
  {kind === 'flow' && (
    <g>
      <rect class="art-fill" x="24" y="38" width="92" height="18" />
      <rect class="art-accent-fill" x="118" y="38" width="34" height="18" />
      <rect class="art-rule" x="154" y="38" width="20" height="18" />
      <rect class="art-rule" x="176" y="38" width="40" height="18" />
      {[0, 1, 2, 3].map((i) => (
        <line class="art-rule" x1={24 + i * 50} x2={58 + i * 50} y1="78" y2="78" />
      ))}
    </g>
  )}
  {kind === 'card' && (
    <g>
      <rect class="art-ink" x="60" y="24" width="120" height="72" rx="6" />
      <rect class="art-accent-fill" x="74" y="42" width="18" height="14" />
      <line class="art-rule" x1="74" x2="140" y1="76" y2="76" />
      <line class="art-rule" x1="150" x2="166" y1="76" y2="76" />
    </g>
  )}
  {kind === 'map' && (
    <g>
      <path class="art-rule" d="M34 88 C70 40 96 96 124 58 S176 30 206 44" stroke-dasharray="3 5" />
      <circle class="art-fill" cx="34" cy="88" r="4" />
      <circle class="art-fill" cx="124" cy="58" r="4" />
      <path class="art-accent" d="M206 44 m-9 -12 a9 9 0 1 1 18 0 c0 7 -9 14 -9 14 s-9 -7 -9 -14 z" />
    </g>
  )}
  {kind === 'inbox' && (
    <g>
      {[0, 1, 2].map((i) => (
        <g>
          <rect class:list={[i === 0 ? 'art-ink' : 'art-rule']} x="44" y={18 + i * 30} width="152" height="22" />
          <line class="art-rule" x1="56" x2={[130, 110, 140][i]} y1={29 + i * 30} y2={29 + i * 30} />
        </g>
      ))}
      <path class="art-accent" d="M170 28 l5 5 l9 -10" />
    </g>
  )}
  {kind === 'doc' && (
    <g>
      <path class="art-ink" d="M82 16 H142 L158 32 V104 H82 Z" />
      <path class="art-rule" d="M142 16 V32 H158" />
      <line class="art-accent" x1="94" x2="134" y1="48" y2="48" />
      <line class="art-rule" x1="94" x2="146" y1="62" y2="62" />
      <line class="art-rule" x1="94" x2="146" y1="76" y2="76" />
      <line class="art-rule" x1="94" x2="124" y1="90" y2="90" />
    </g>
  )}
  {kind === 'sync' && (
    <g>
      <rect class="art-ink" x="52" y="22" width="40" height="76" rx="5" />
      <rect class="art-ink" x="148" y="22" width="40" height="76" rx="5" />
      <path class="art-accent" d="M102 50 H138 M132 44 L138 50 L132 56" />
      <path class="art-accent" d="M138 72 H102 M108 66 L102 72 L108 78" />
    </g>
  )}
  {kind === 'timeline' && (
    <g>
      <line class="art-rule" x1="24" x2="216" y1="60" y2="60" />
      {[0, 1, 2, 3, 4].map((i) => (
        <g>
          <circle class:list={[i === 3 ? 'art-accent-fill' : 'art-fill']} cx={44 + i * 38} cy="60" r={i === 3 ? 6 : 4} />
          <line class="art-rule" x1={44 + i * 38} x2={44 + i * 38} y1={i % 2 ? 70 : 50} y2={i % 2 ? 84 : 36} />
        </g>
      ))}
    </g>
  )}
  {kind === 'levels' && (
    <g>
      {[0, 1, 2, 3].map((i) => (
        <g>
          <rect class="art-rule" x={38 + i * 44} y="26" width="30" height="68" />
          <rect class:list={[i === 2 ? 'art-accent-fill' : 'art-fill']} x={38 + i * 44} y={26 + [0, 24, 50, 68][i]} width="30" height={[68, 44, 18, 0][i]} />
        </g>
      ))}
    </g>
  )}
</svg>
